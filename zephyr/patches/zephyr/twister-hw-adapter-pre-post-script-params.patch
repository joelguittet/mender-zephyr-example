From 3fd7d79f94fdc0c33433f2c8d4317fad4bd27c05 Mon Sep 17 00:00:00 2001
From: Joel Guittet <jguittet@witekio.com>
Date: Wed, 10 Jun 2026 09:16:45 +0200
Subject: [PATCH 1/4] twister: allow arguments to pre/post scripts

This improvment allows to pass parameters to the pre/post scripts.

Signed-off-by: Joel Guittet <jguittet@witekio.com>
---
 .../src/twister_harness/device/hardware_adapter.py        | 3 ++-
 scripts/pylib/twister/twisterlib/handlers.py              | 8 +++++---
 2 files changed, 7 insertions(+), 4 deletions(-)

diff --git a/scripts/pylib/pytest-twister-harness/src/twister_harness/device/hardware_adapter.py b/scripts/pylib/pytest-twister-harness/src/twister_harness/device/hardware_adapter.py
index fd6f4994a91..325ff10d7ae 100644
--- a/scripts/pylib/pytest-twister-harness/src/twister_harness/device/hardware_adapter.py
+++ b/scripts/pylib/pytest-twister-harness/src/twister_harness/device/hardware_adapter.py
@@ -5,6 +5,7 @@
 from __future__ import annotations
 
 import logging
+import shlex
 import subprocess
 import time
 from pathlib import Path
@@ -197,7 +198,7 @@ class HardwareAdapter(DeviceAdapter):
     @staticmethod
     def _run_custom_script(script_path: str | Path, timeout: float) -> None:
         with subprocess.Popen(
-            str(script_path), stderr=subprocess.PIPE, stdout=subprocess.PIPE
+            shlex.split(str(script_path)), stderr=subprocess.PIPE, stdout=subprocess.PIPE
         ) as proc:
             try:
                 stdout, stderr = proc.communicate(timeout=timeout)
diff --git a/scripts/pylib/twister/twisterlib/handlers.py b/scripts/pylib/twister/twisterlib/handlers.py
index 621e9d4700d..0695693b5ce 100755
--- a/scripts/pylib/twister/twisterlib/handlers.py
+++ b/scripts/pylib/twister/twisterlib/handlers.py
@@ -555,8 +555,10 @@ class DeviceHandler(Handler):
                     break
 
     @staticmethod
-    def run_custom_script(script, timeout):
-        with subprocess.Popen(script, stderr=subprocess.PIPE, stdout=subprocess.PIPE) as proc:
+    def run_custom_script(script_path: str | Path, timeout: float):
+        with subprocess.Popen(
+            shlex.split(str(script_path)), stderr=subprocess.PIPE, stdout=subprocess.PIPE
+        ) as proc:
             try:
                 stdout, stderr = proc.communicate(timeout=timeout)
                 logger.debug(stdout.decode())
@@ -566,7 +568,7 @@ class DeviceHandler(Handler):
             except subprocess.TimeoutExpired:
                 proc.kill()
                 proc.communicate()
-                logger.error(f"{script} timed out")
+                logger.error(f"{script_path} timed out")
 
     def _create_flash_command(self, hardware):
         flash_command = next(csv.reader([self.options.flash_command]))
