From 00f32914b681ac7f30a9e042c179dc8d431b7880 Mon Sep 17 00:00:00 2001
From: Joel Guittet <jguittet@witekio.com>
Date: Wed, 10 Jun 2026 09:16:45 +0200
Subject: [PATCH 1/1] twister: allow arguments to pre/post scripts of the
 hardware map file

This improvment allows to pass parameters to the pre/post scripts
defined in the hardware map file.

Signed-off-by: Joel Guittet <jguittet@witekio.com>
---
 .../src/twister_harness/device/hardware_adapter.py             | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/scripts/pylib/pytest-twister-harness/src/twister_harness/device/hardware_adapter.py b/scripts/pylib/pytest-twister-harness/src/twister_harness/device/hardware_adapter.py
index 766218c4c0e..1c685d9b4ec 100644
--- a/scripts/pylib/pytest-twister-harness/src/twister_harness/device/hardware_adapter.py
+++ b/scripts/pylib/pytest-twister-harness/src/twister_harness/device/hardware_adapter.py
@@ -5,6 +5,7 @@
 from __future__ import annotations
 
 import logging
+import shlex
 import subprocess
 import time
 from pathlib import Path
@@ -187,7 +188,7 @@ class HardwareAdapter(DeviceAdapter):
     @staticmethod
     def _run_custom_script(script_path: str | Path, timeout: float) -> None:
         with subprocess.Popen(
-            str(script_path), stderr=subprocess.PIPE, stdout=subprocess.PIPE
+            shlex.split(str(script_path)), stderr=subprocess.PIPE, stdout=subprocess.PIPE
         ) as proc:
             try:
                 stdout, stderr = proc.communicate(timeout=timeout)
