From 9e214088db76de4d06ecb2ab354fb47c9f8651ae Mon Sep 17 00:00:00 2001
From: Joel Guittet <joelguittet@gmail.com>
Date: Mon, 15 Jun 2026 22:07:48 +0200
Subject: [PATCH 1/1] logs airoc wifi

---
 drivers/wifi/infineon/airoc_wifi.c | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/drivers/wifi/infineon/airoc_wifi.c b/drivers/wifi/infineon/airoc_wifi.c
index 0ae92330a5f..98735db56cd 100644
--- a/drivers/wifi/infineon/airoc_wifi.c
+++ b/drivers/wifi/infineon/airoc_wifi.c
@@ -588,6 +588,7 @@ static int airoc_mgmt_connect(const struct device *dev, struct wifi_connect_req_
 	whd_scan_result_t usr_result = {0};
 	/* Try to scan ssid to define security */
 	whd_scan_result_t tmp_result = {0};
+	LOG_ERR("CALLING airoc_mgmt_connect");
 
 	if (k_sem_take(&data->sema_common, K_MSEC(AIROC_WIFI_WAIT_SEMA_MS)) != 0) {
 		return -EAGAIN;
@@ -653,7 +654,9 @@ error:
 	} else {
 		net_if_dormant_off(data->iface);
 		data->is_sta_connected = true;
+		LOG_ERR("CALLING airoc_mgmt_connect is_sta_connected=true");
 #if defined(CONFIG_NET_DHCPV4)
+		LOG_ERR("CALLING airoc_mgmt_connect restart dhcpv4");
 		net_dhcpv4_restart(data->iface);
 #endif /* defined(CONFIG_NET_DHCPV4) */
 	}
