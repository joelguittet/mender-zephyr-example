From 5965475ed10b6d3c49fc5add7f52bb19186d7a04 Mon Sep 17 00:00:00 2001
From: Joel Guittet <joelguittet@gmail.com>
Date: Mon, 23 Mar 2026 09:16:36 +0100
Subject: [PATCH 1/2] scripts: twister: base_params in the hardware map config
 file

Add the ability to configure additional runner parameters.

For instance the Raspberry Pi boards require a specific openocd version
with rp2xxx driver support.

Signed-off-by: Joel Guittet <joelguittet@gmail.com>
---
 .../src/twister_harness/device/hardware_adapter.py   |  3 +++
 .../src/twister_harness/plugin.py                    |  5 +++++
 .../src/twister_harness/twister_harness_config.py    |  6 ++++++
 .../tests/device/hardware_adapter_test.py            | 12 ++++++++++++
 scripts/pylib/twister/twisterlib/handlers.py         |  5 +++++
 scripts/pylib/twister/twisterlib/hardwaredata.py     |  1 +
 scripts/pylib/twister/twisterlib/hardwaremap.py      |  2 ++
 scripts/schemas/twister/hwmap-schema.yaml            |  4 ++++
 scripts/tests/twister/test_handlers.py               |  1 +
 scripts/tests/twister/test_hardwaremap.py            |  2 ++
 10 files changed, 41 insertions(+)

diff --git a/scripts/pylib/pytest-twister-harness/src/twister_harness/device/hardware_adapter.py b/scripts/pylib/pytest-twister-harness/src/twister_harness/device/hardware_adapter.py
index 766218c4c0e..b787e14473a 100644
--- a/scripts/pylib/pytest-twister-harness/src/twister_harness/device/hardware_adapter.py
+++ b/scripts/pylib/pytest-twister-harness/src/twister_harness/device/hardware_adapter.py
@@ -78,6 +78,9 @@ class HardwareAdapter(DeviceAdapter):
         extra_args: list[str] = []
         runner = self.device_config.runner
         base_args.extend(['--runner', runner])
+        if self.device_config.base_params:
+            for param in self.device_config.base_params:
+                base_args.append(param)
         if self.device_config.runner_params:
             for param in self.device_config.runner_params:
                 extra_args.append(param)
diff --git a/scripts/pylib/pytest-twister-harness/src/twister_harness/plugin.py b/scripts/pylib/pytest-twister-harness/src/twister_harness/plugin.py
