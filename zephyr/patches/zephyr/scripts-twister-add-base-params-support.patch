+++ b/scripts/pylib/pytest-twister-harness/src/twister_harness/plugin.py
@@ -77,6 +77,11 @@ def pytest_addoption(parser: pytest.Parser):
         '--runner',
         help='Use the specified west runner (pyocd, nrfjprog, etc.).'
     )
+    twister_harness_group.addoption(
+        '--base-params',
+        action='append',
+        help='Use the specified west base params.'
+    )
     twister_harness_group.addoption(
         '--runner-params',
         action='append',
