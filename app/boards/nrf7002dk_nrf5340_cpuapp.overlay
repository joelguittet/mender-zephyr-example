/delete-node/ &boot_partition;
/delete-node/ &slot0_partition;
/delete-node/ &slot1_partition;
/delete-node/ &tfm_ps_partition;
/delete-node/ &tfm_its_partition;
/delete-node/ &tfm_otp_partition;
/delete-node/ &storage_partition;

/ {
    fstab {
        compatible = "zephyr,fstab";
        littlefs: littlefs {
            compatible = "zephyr,fstab,littlefs";
            read-size = <16>;
            prog-size = <16>;
            cache-size = <16>;
            lookahead-size = <16>;
            block-cycles = <512>;
            partition = <&littlefs_partition>;
            mount-point = "/littlefs";
            automount;
        };
    };
};

&flash0 {
    status = "okay";
    partitions {
        compatible = "fixed-partitions";
        #address-cells = <1>;
        #size-cells = <1>;
        /* Bootloader slot: 56KB */
        boot_partition: partition@0 {
            label = "mcuboot";
            reg = <0x00000000 DT_SIZE_K(56)>;
            read-only;
        };
        /* Storage slot: 8KB */
        storage_partition: partition@e0000 {
            label = "storage";
            reg = <0x000E0000 DT_SIZE_K(8)>;
        };
        /* Application slot: 960KB */
        slot0_partition: partition@10000 {
            label = "image-0";
            reg = <0x00010000 DT_SIZE_K(960)>;
        };
    };
};

&mx25r64 {
    status = "okay";
    partitions {
        compatible = "fixed-partitions";
        #address-cells = <1>;
        #size-cells = <1>;
        /* Update slot: 960KB */
        slot1_partition: partition@0 {
            label = "image-1";
            reg = <0x00000000 DT_SIZE_K(960)>;
        };
        /* Swap slot: 64KB */
        scratch_partition: partition@f0000 {
            label = "image-scratch";
            reg = <0x000F0000 DT_SIZE_K(64)>;
        };
        /* LittleFS slot: 4MB */
        littlefs_partition: partition@400000 {
            label = "littlefs";
            reg = <0x00400000 DT_SIZE_M(4)>;
        };
    };
};

&wlan0 {
    status = "okay";
};
