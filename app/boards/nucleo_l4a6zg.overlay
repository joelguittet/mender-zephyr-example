/ {
    chosen {
        zephyr,code-partition = &slot0_partition;
    };

    fstab {
        compatible = "zephyr,fstab";
        littlefs: littlefs {
            compatible = "zephyr,fstab,littlefs";
            read-size = <16>;
            prog-size = <16>;
            cache-size = <16>;
            lookahead-size = <16>;
            block-cycles = <512>;
            partition = <&littlefs_partition>;
            mount-point = "/littlefs";
            automount;
        };
    };
};

&flash0 {
    //TODO should be part of zephyr
    //ranges = <0x0 0x8000000 DT_SIZE_K(1024)>;
    //#address-cells = <1>;
    //#size-cells = <1>;
    partitions {
        //ranges;
        compatible = "fixed-partitions";
        #address-cells = <1>;
        #size-cells = <1>;
        /* Bootloader slot: 56KB */
        boot_partition: partition@0 {
            label = "mcuboot";
            reg = <0x00000000 DT_SIZE_K(56)>;
            read-only;
        };
        /* Application slot: 384KB */
        slot0_partition: partition@e000 {
            label = "image-0";
            reg = <0x0000E000 DT_SIZE_K(384)>;
        };
        /* Update slot: 384KB */
        slot1_partition: partition@6e000 {
            label = "image-1";
            reg = <0x0006E000 DT_SIZE_K(384)>;
        };
        /* Swap slot: 64KB */
        scratch_partition: partition@ce000 {
            label = "image-scratch";
            reg = <0x000CE000 DT_SIZE_K(64)>;
        };
        /* Storage slot: 8KB */
        storage_partition: partition@de000 {
            label = "storage";
            reg = <0x000DE000 DT_SIZE_K(8)>;
        };
        /* LittleFS slot: 128KB */
        littlefs_partition: partition@e0000 {
            label = "littlefs";
            reg = <0x000E0000 DT_SIZE_K(128)>;
        };
    };
};

&arduino_i2c {
    status = "okay";

    /* ATECC608A Crypto Element */
    atecc608a@60 {
        compatible = "atmel,atecc608";
        reg = <0x60>;
    };
};

&arduino_spi {
    status = "okay";

    /* W5500 SPI/Ethernet Controller */
    eth_w5500: eth_w5500@0 {
        compatible = "wiznet,w5500";
        reg = <0x0>;
        spi-max-frequency = <20000000>;
        int-gpios = <&arduino_header ARDUINO_HEADER_R3_D2 GPIO_ACTIVE_LOW>;
        /* MAC address is used to identify the device on the mender-server */
        local-mac-address = [00 08 DC 01 02 03];
    };
};

&clk_hsi48 {
    /* HSI48 required for RNG */
    status = "okay";
};

&rng {
    status = "okay";
};
